<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>FLUXATLAS launch film</title><script src="assets/gsap.min.js"></script>
<style>
*{box-sizing:border-box}figure{margin:0}html,body{margin:0;width:1920px;height:1080px;overflow:hidden;background:#f4f2e9;color:#172d36;font-family:"Helvetica Neue",Arial,sans-serif}#root{width:1920px;height:1080px;position:relative}.scene{position:absolute;inset:0;width:1920px;height:1080px;background:#f4f2e9;overflow:hidden}.scene-content{width:100%;height:100%;padding:74px 100px 70px;display:flex;flex-direction:column;gap:25px}#s2{opacity:0}#s3{opacity:0}#s4{opacity:0}.brand{display:flex;align-items:center;gap:15px;font-size:33px;font-weight:700;letter-spacing:2px}.brand img{width:48px;height:48px}.brand span span{font-weight:300}.eyebrow{font:19px ui-monospace,Menlo,monospace;letter-spacing:3px;color:#5d686d}.eyebrow .dot{display:inline-block;width:8px;height:8px;background:#d86435;margin-right:14px;border-radius:50%}h1,h2,p{margin:0}h1{font-size:97px;line-height:1.08;font-weight:500;letter-spacing:-4px;max-width:760px}h1 em,h2 em{font-family:Georgia,serif;font-weight:400;color:#3a7383}h2{font-size:67px;line-height:1.08;font-weight:500;letter-spacing:-2px}.row{display:flex;gap:40px;align-items:center;flex:1;min-height:0}.hook-copy{flex:0 0 760px;display:flex;flex-direction:column;gap:32px}.hook-figure{flex:1;border:1px solid #c3cfca;background:#faf9f4;padding:24px 18px 8px;box-shadow:18px 24px 0 #e6e9e1;min-width:0}.hook-figure img{width:100%;display:block}.caption{font:18px ui-monospace,Menlo,monospace;color:#5d686d;line-height:1.5}.hook-figure .caption{padding:0 25px 12px}.subtitle{font-size:28px;line-height:1.5;max-width:660px;color:#5d686d}.bottom-rule{border-top:1px solid #bfcac4;padding-top:20px;display:flex;justify-content:space-between;gap:20px;font:18px ui-monospace,Menlo,monospace;color:#5d686d}.header{display:flex;justify-content:space-between;align-items:center}.paired{display:flex;gap:28px;min-height:0}.field-panel{flex:1;background:#faf9f4;border:1px solid #c5d0c9;padding:22px 24px 12px;min-width:0}.field-label{display:flex;justify-content:space-between;font-size:24px;align-items:center;gap:10px;margin-bottom:8px}.field-label small{font:16px ui-monospace,Menlo,monospace;color:#5d686d}.field-label i{display:inline-block;width:9px;height:9px;margin-right:12px;border-radius:50%;background:#d86435}.field-label.blue i{background:#3a7383}.field-panel img{width:100%;display:block;max-height:515px}.legend{width:100%;height:60px;display:block}.s2-heading{margin:15px 0 0}.evidence-row{display:flex;gap:30px;align-items:stretch;flex:1;min-height:0}.evidence-panel{background:#faf9f4;border:1px solid #c5d0c9;padding:26px;display:flex;flex-direction:column;gap:10px;min-width:0}.evidence-panel.error{flex:0 0 720px}.evidence-panel.study{flex:1}.evidence-panel img{display:block;width:100%;flex:1;min-height:0;object-fit:contain}.evidence-panel h3{font-size:26px;font-weight:500;margin:0}.evidence-panel p{font:18px/1.5 ui-monospace,Menlo,monospace;color:#5d686d}.closing-row{display:flex;align-items:center;gap:60px;flex:1;min-height:0}.closing-copy{flex:0 0 510px;display:flex;flex-direction:column;gap:38px}.closing-copy h2{font-size:74px;line-height:1.13}.closing-copy .brand{font-size:45px;letter-spacing:1px}.closing-copy .brand img{width:65px;height:65px}.closing-screenshot{flex:1;min-width:0;background:#faf9f4;border:1px solid #c5d0c9;padding:9px;box-shadow:18px 24px 0 #e3e7df;transform:rotate(-1deg)}.closing-screenshot img{display:block;width:100%;max-height:730px;object-fit:contain}.url{font:23px/1.6 ui-monospace,Menlo,monospace;color:#3a7383;overflow-wrap:anywhere}.scope{font:18px/1.5 ui-monospace,Menlo,monospace;color:#5d686d}.small-brand{font-size:25px;letter-spacing:1px}.small-brand img{width:38px;height:38px}.progress{position:absolute;left:0;bottom:0;height:5px;background:#d86435;width:1920px;transform-origin:left;z-index:10}.figure-note{font-size:21px;line-height:1.5;color:#5d686d;max-width:1650px}.s3-header{display:flex;flex-direction:column;gap:20px;margin:14px 0 7px}
</style></head><body>
<div id="root" data-composition-id="fluxatlas-launch" data-width="1920" data-height="1080" data-start="0" data-duration="20">
<section class="scene" id="s1"><div class="scene-content">
<div class="brand s1-brand"><img src="assets/mark-1.svg" alt=""><span>FLUX<span>ATLAS</span></span></div>
<div class="row"><div class="hook-copy"><div class="eyebrow s1-eyebrow"><span class="dot"></span>A RADIATION TRANSPORT OBSERVATORY</div><h1 class="s1-title">Learn the field. <em>Keep the reference.</em></h1><p class="subtitle s1-subtitle">Independent OpenMC transport meets a trained neural field model.</p></div><figure class="hook-figure s1-figure"><img src="assets/reference-hook.svg" alt="Actual total scalar flux from an independent OpenMC simulation"><figcaption class="caption">OPENMC REFERENCE · ##CASE##<br>##HISTORIES## source histories</figcaption></figure></div>
<div class="bottom-rule s1-footer"><span>EDUCATIONAL · SYNTHETIC TWO-GROUP NEUTRON DATA</span><span>REPRODUCIBLE EXPERIMENT / 001</span></div></div></section>
<section class="scene" id="s2"><div class="scene-content">
<div class="header"><span class="eyebrow s2-eyebrow"><span class="dot"></span>01 / INDEPENDENT COMPARISON</span><div class="brand small-brand s2-brand"><img src="assets/mark-2.svg" alt=""><span>FLUX<span>ATLAS</span></span></div></div>
<h2 class="s2-heading">Physics beside <em>prediction.</em></h2>
<div class="paired"><div class="field-panel s2-reference"><div class="field-label"><span><i></i>OpenMC reference</span><small>INDEPENDENT HISTORIES</small></div><img src="assets/reference.svg" alt="Independent OpenMC reference scalar flux"></div><div class="field-panel s2-model"><div class="field-label blue"><span><i></i>Trained prediction</span><small>PHYSICS + LEARNED RESIDUAL</small></div><img src="assets/prediction.svg" alt="Genuinely trained spatial surrogate prediction"></div></div>
<img class="legend s2-legend" src="assets/legend.svg" alt="Shared logarithmic color scale in inverse square centimetres per source particle">
<div class="bottom-rule s2-footer"><span>TOTAL FLUX · BOTH ENERGY GROUPS · ##CASE##</span><span>HELD-OUT CONFIGURATION · ##HISTORIES## REFERENCE HISTORIES</span></div></div></section>
<section class="scene" id="s3"><div class="scene-content">
<div class="header"><span class="eyebrow s3-eyebrow"><span class="dot"></span>02 / THE RESEARCH RECORD</span><div class="brand small-brand s3-brand"><img src="assets/mark-3.svg" alt=""><span>FLUX<span>ATLAS</span></span></div></div>
<div class="s3-header"><h2 class="s3-heading">Make the limits <em>visible.</em></h2><p class="figure-note s3-subtitle">Held-out fields. Calibrated intervals. History-matched trials.</p></div>
<div class="evidence-row"><div class="evidence-panel error s3-error"><h3>Absolute total-flux error</h3><img src="assets/error.svg" alt="Absolute difference between actual total flux reference and trained model"><p>##CASE## · range 0 to ##ERRORMAX## cm⁻²/source</p></div><div class="evidence-panel study s3-study"><h3>Active versus random sampling</h3><img src="assets/acquisition.svg" alt="Saved history-matched active and random sampling study curves"><p>Mean of ##REPEATS## repeats · held-out relative L₂<br>All low-fidelity candidate histories included</p></div></div>
<div class="bottom-rule s3-footer"><span>INTERVALS TARGET FINITE-HISTORY MC ESTIMATES</span><span>NO CLAIM OF UNIVERSAL ACTIVE-LEARNING SUPERIORITY</span></div></div></section>
<section class="scene" id="s4"><div class="scene-content">
<div class="eyebrow s4-eyebrow"><span class="dot"></span>OPEN SOURCE · REPRODUCIBLE BY DESIGN</div>
<div class="closing-row"><div class="closing-copy"><div class="brand s4-brand"><img src="assets/mark-4.svg" alt=""><span>FLUX<span>ATLAS</span></span></div><h2 class="s4-heading">Reproduce. Compare. <em>Inspect.</em></h2><p class="url s4-url">github.com/nazeeh111/FLUXATLAS</p></div><figure class="closing-screenshot s4-shot"><img src="assets/observatory-crop.png" alt="Genuine browser screenshot of the FLUXATLAS observatory"></figure></div>
<div class="bottom-rule s4-footer"><span>EDUCATIONAL RESEARCH · SYNTHETIC MATERIALS</span><span>NOT VALIDATED FOR SAFETY OR REGULATORY ANALYSIS</span></div></div></section>
<div class="progress" data-layout-ignore></div>
</div>
<script>
window.__timelines=window.__timelines||{};
const tl=gsap.timeline({paused:true});
function entrance(selector,vars,time){tl.from(selector,{...vars,duration:vars.duration||.65},time)}
entrance('.s1-brand',{y:-14,opacity:0,ease:'power2.out'},.15);
entrance('.s1-eyebrow',{x:-18,opacity:0,ease:'sine.out'},.3);
entrance('.s1-title',{y:32,opacity:0,ease:'power3.out'},.45);
entrance('.s1-subtitle',{y:18,opacity:0,ease:'power1.out'},.7);
entrance('.s1-figure',{x:35,scale:.97,opacity:0,ease:'power2.out'},.4);
entrance('.s1-footer',{opacity:0,ease:'sine.out'},.85);
// Topic transitions are crossfades of complete scenes; outgoing content remains
// fully formed until the transition begins. No fabricated data evolves in time.
function crossfade(oldScene,newScene,time){tl.to(oldScene,{opacity:0,duration:.5,ease:'sine.inOut'},time);tl.fromTo(newScene,{opacity:0},{opacity:1,duration:.5,ease:'sine.inOut'},time)}
crossfade('#s1','#s2',3.75);
entrance('.s2-eyebrow',{x:-15,opacity:0,ease:'power2.out'},4.02);entrance('.s2-brand',{y:-10,opacity:0,ease:'sine.out'},4.05);
entrance('.s2-heading',{y:22,opacity:0,ease:'power3.out'},4.1);entrance('.s2-reference',{x:-22,opacity:0,ease:'power1.out'},4.3);entrance('.s2-model',{x:22,opacity:0,ease:'power2.out'},4.55);entrance('.s2-legend',{opacity:0,y:8,ease:'sine.out'},4.85);entrance('.s2-footer',{opacity:0,ease:'power1.out'},5.1);
crossfade('#s2','#s3',9.75);
entrance('.s3-eyebrow',{x:-15,opacity:0,ease:'power2.out'},10.02);entrance('.s3-brand',{y:-10,opacity:0,ease:'sine.out'},10.05);entrance('.s3-heading',{y:22,opacity:0,ease:'power3.out'},10.1);entrance('.s3-subtitle',{y:12,opacity:0,ease:'power1.out'},10.3);entrance('.s3-error',{x:-22,opacity:0,ease:'power2.out'},10.4);entrance('.s3-study',{x:22,opacity:0,ease:'power3.out'},10.65);entrance('.s3-footer',{opacity:0,ease:'sine.out'},10.95);
crossfade('#s3','#s4',15.75);
entrance('.s4-eyebrow',{x:-15,opacity:0,ease:'power2.out'},16.02);entrance('.s4-brand',{y:-12,opacity:0,ease:'sine.out'},16.1);entrance('.s4-heading',{y:25,opacity:0,ease:'power3.out'},16.2);entrance('.s4-url',{y:15,opacity:0,ease:'power1.out'},16.45);entrance('.s4-shot',{x:30,scale:.98,opacity:0,ease:'power2.out'},16.35);entrance('.s4-footer',{opacity:0,ease:'sine.out'},16.65);
tl.fromTo('.progress',{scaleX:0},{scaleX:1,duration:20,ease:'none'},0);
window.__timelines['fluxatlas-launch']=tl;
</script></body></html>
